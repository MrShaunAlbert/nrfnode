 namespace chip {
 namespace Crypto {
 
+namespace {
+// Reduces a big-endian integer of up to kSpake2p_WS_Length bytes modulo the P-256 group order.
+void ReduceModOrder(const uint8_t * in, size_t len, uint8_t * out)
+{
+    static const uint8_t kOrder[33] = { 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
+                                        0xBC, 0xE6, 0xFA, 0xAD, 0xA7, 0x17, 0x9E, 0x84, 0xF3, 0xB9, 0xCA, 0xC2, 0xFC, 0x63, 0x25, 0x51 };
+    uint8_t r[33]                 = { 0 };
+
+    for (size_t i = 0; i < len * 8; i++)
+    {
+        unsigned carry = (in[i / 8] >> (7 - (i % 8))) & 1u;
+        for (int j = 32; j >= 0; j--)
+        {
+            unsigned v = (static_cast<unsigned>(r[j]) << 1) | carry;
+            r[j]       = static_cast<uint8_t>(v);
+            carry      = v >> 8;
+        }
+        if (memcmp(r, kOrder, sizeof(r)) >= 0)
+        {
+            unsigned borrow = 0;
+            for (int j = 32; j >= 0; j--)
+            {
+                int v   = static_cast<int>(r[j]) - kOrder[j] - static_cast<int>(borrow);
+                borrow  = v < 0 ? 1 : 0;
+                r[j]    = static_cast<uint8_t>(v);
+            }
+        }
+    }
+    memcpy(out, r + 1, 32);
+}
