{
  "baseboard": {
    "module_connector": {
      "description": "Generalized 20-pin module interface: 2x SPI, 1x I2C, 2x analog/digital IO. Any non-power or dedikatedpin may be reconfigured as GPIO (incl. interrupt-on-pin) thanks to the PAN1780/nRF52840 signal mux flexibility.",
      "connector_part": "Samtec LSS-120-01-L-DV-A",
      "grounding_note": "GND_HV, GND_LV, and GND_LV_SHIELD are just pin names for current distribution across multiple pins; all are electrically common (same ground net) on the baseboard — there is no isolation between them.",
      "pins": [
        { "pin": 1, "signal": "VCC_MAIN", "direction": "out_to_module" },
        { "pin": 2, "signal": "RESERVED_POWER", "direction": "nc", "notes": "Spare HV-adjacent pin, reserved for future power use only" },
        { "pin": 3, "signal": "GND_HV", "direction": "bidirectional" },
        { "pin": 4, "signal": "GND_LV", "direction": "bidirectional" },
        { "pin": 5, "signal": "VCC_3V3", "direction": "out_to_module" },
        { "pin": 6, "signal": "VCC_SWITCHED_3V3", "direction": "out_to_module" },
        { "pin": 7, "signal": "EN_RESET", "direction": "out_to_module" },
        { "pin": 8, "signal": "SPI1_SCK", "direction": "preferred_out_to_module", "gpio_capable": true },
        { "pin": 9, "signal": "SPI1_MOSI", "direction": "preferred_out_to_module", "gpio_capable": true },
        { "pin": 10, "signal": "SPI1_MISO", "direction": "preferred_in_to_base", "gpio_capable": true },
        { "pin": 11, "signal": "SPI1_CS", "direction": "preferred_out_to_module", "gpio_capable": true },
        { "pin": 12, "signal": "SPI2_SCK", "direction": "preferred_out_to_module", "gpio_capable": true },
        { "pin": 13, "signal": "SPI2_MOSI", "direction": "preferred_out_to_module", "gpio_capable": true },
        { "pin": 14, "signal": "SPI2_MISO", "direction": "preferred_in_to_base", "gpio_capable": true },
        { "pin": 15, "signal": "SPI2_CS", "direction": "preferred_out_to_module", "gpio_capable": true },
        { "pin": 16, "signal": "I2C_SCL", "direction": "preferred_bidirectional_open_drain", "gpio_capable": true },
        { "pin": 17, "signal": "I2C_SDA", "direction": "preferred_bidirectional_open_drain", "gpio_capable": true },
        { "pin": 18, "signal": "AIO1", "direction": "preferred_in_to_base", "gpio_capable": true },
        { "pin": 19, "signal": "AIO2", "direction": "preferred_in_to_base", "gpio_capable": true },
        { "pin": 20, "signal": "GND_LV_SHIELD", "direction": "bidirectional" }
      ]
    },

    "module_slot_policy": {
      "exclusivity": "Only one module is fitted at a time; the connector is shared/reused across variants.",
      "supported_variants": ["sensor_module", "poe_pd_module", "poe_pse_module"],
      "extensible": true,
      "identification": "Module type identified in software before power sequencing (see safety_rules.enable_logic)."
    },

    "communication": {
      "spi": [
        {
          "bus": "SPI1",
          "master": "PAN1780",
          "signals": ["SPI1_SCK", "SPI1_MOSI", "SPI1_MISO", "SPI1_CS"],
          "modules_supported": ["sensor_module", "poe_pd_module", "poe_pse_module"]
        },
        {
          "bus": "SPI2",
          "master": "PAN1780",
          "signals": ["SPI2_SCK", "SPI2_MOSI", "SPI2_MISO", "SPI2_CS"],
          "modules_supported": ["sensor_module", "poe_pd_module", "poe_pse_module"]
        }
      ],
      "i2c": {
        "master": "PAN1780",
        "signals": ["I2C_SCL", "I2C_SDA"],
        "modules_supported": ["sensor_module"]
      },
      "gpio_mux": {
        "description": "Any pin not currently used by its bus/power role can be reassigned as GPIO, including interrupt-on-pin, via the PAN1780/nRF52840 mux.",
        "eligible_pins": ["SPI1_SCK", "SPI1_MOSI", "SPI1_MISO", "SPI1_CS", "SPI2_SCK", "SPI2_MOSI", "SPI2_MISO", "SPI2_CS", "I2C_SCL", "I2C_SDA", "AIO1", "AIO2"]
      }
    },

    "aio_pins": {
      "AIO1": {
        "source": "module",
        "modes": ["analog_in", "digital_in", "digital_out", "interrupt"],
        "usage": ["VCC monitoring", "temperature", "PoE PD/PSE VOUT", "status/interrupt"]
      },
      "AIO2": {
        "source": "module",
        "modes": ["analog_in", "digital_in", "digital_out", "interrupt"],
        "usage": ["extra analog sensor", "PoE supply monitor", "status/interrupt"]
      }
    },

    "safety_rules": {
      "enable_logic": {
        "no_high_signals_before": [
          "module_identified_in_software",
          "module_power_good"
        ],
        "signals_protected": ["EN_RESET", "VCC_SWITCHED_3V3"]
      },
      "power_priority_note": "Internal 3.3V-rail arbitration (TPS2120: mains-derived vs battery-derived) and VCC_MAIN's own local_buck/poe_pd priority are baseboard implementation details, see hw/baseboard.json power_mux.",
      "module_power_policy": {
        "modules_may_generate_own_3v3": true,
        "must_be_controlled_by": ["VCC_SWITCHED_3V3", "EN_RESET"]
      }
    }
  }
}
