{
  "baseboard": {
    "power": {
      "rails": {
        "VCC_MAIN": {
          "voltage": "11-30V",
          "source": ["local_buck", "poe_pd_via_diode", "battery_via_tps2120"],
          "priority": ["local_buck", "poe_pd", "battery"],
          "description": "Primary HV rail for entire system"
        },
        "VCC_PD": {
          "voltage": "12V",
          "source": "poe_pd_module",
          "diode_to_VCC_MAIN": true,
          "description": "Only exists on PD module; merged locally before returning to baseboard"
        },
        "VCC_BAT": {
          "voltage": "battery_voltage",
          "description": "Backup supply for graceful shutdown"
        },
        "3V3_MAIN": {
          "voltage": "3.3V",
          "source": "local_regulator",
          "description": "Primary 3.3V rail for logic"
        },
        "3V3_MOD_IN": {
          "voltage": "3.3V",
          "source": "3V3_MAIN",
          "description": "3.3V rail forwarded to module connector"
        },
        "VCC_SWITCHED_3V3": {
          "voltage": "3.3V",
          "source": "load_switch",
          "description": "Controlled 3.3V rail for W6100/PSE logic on ETH modules"
        }
      },

      "control_logic": {
        "tps2120": {
          "inputs": ["VCC_MAIN", "VCC_BAT"],
          "output": "VCC_MAIN",
          "priority": "VCC_MAIN_over_VCC_BAT",
          "clear_thresholds": true,
          "no_reset_flapping": true
        },
        "load_switch": {
          "input": "3V3_MAIN",
          "output": "VCC_SWITCHED_3V3",
          "enable_signal": "module_identified_and_power_good"
        }
      }
    },

    "module_connector": {
      "pins": [
        { "pin": 1, "signal": "VCC_MAIN", "direction": "out_to_module" },
        { "pin": 2, "signal": "NC", "direction": "nc" },
        { "pin": 3, "signal": "GND_HV1", "direction": "bidirectional" },
        { "pin": 4, "signal": "GND_HV2", "direction": "bidirectional" },
        { "pin": 5, "signal": "3V3_MOD_IN", "direction": "out_to_module" },
        { "pin": 6, "signal": "VCC_SWITCHED_3V3", "direction": "out_to_module" },
        { "pin": 7, "signal": "SPI_SCK", "direction": "out_to_module" },
        { "pin": 8, "signal": "SPI_MOSI", "direction": "out_to_module" },
        { "pin": 9, "signal": "SPI_MISO", "direction": "in_to_base" },
        { "pin": 10, "signal": "SPI_CS", "direction": "out_to_module" },
        { "pin": 11, "signal": "I2C_SCL", "direction": "bidirectional_open_drain" },
        { "pin": 12, "signal": "I2C_SDA", "direction": "bidirectional_open_drain" },
        { "pin": 13, "signal": "INT1", "direction": "in_to_base" },
        { "pin": 14, "signal": "INT2_STATUS", "direction": "in_to_base" },
        { "pin": 15, "signal": "EN_RESET", "direction": "out_to_module" },
        { "pin": 16, "signal": "ADC_MOD1", "direction": "in_to_base" },
        { "pin": 17, "signal": "ADC_MOD2", "direction": "in_to_base" },
        { "pin": 18, "signal": "GPIO_GEN1", "direction": "configurable" },
        { "pin": 19, "signal": "GPIO_GEN2", "direction": "configurable" },
        { "pin": 20, "signal": "GND_LV_SHIELD", "direction": "bidirectional" }
      ]
    },

    "communication": {
      "spi": {
        "master": "PAN1780",
        "signals": ["SPI_SCK", "SPI_MOSI", "SPI_MISO", "SPI_CS"],
        "modules_supported": ["sensor_module", "poe_pd_module", "poe_pse_module"]
      },
      "i2c": {
        "master": "PAN1780",
        "signals": ["I2C_SCL", "I2C_SDA"],
        "modules_supported": ["sensor_module"]
      },
      "interrupts": {
        "INT1": "Primary interrupt line",
        "INT2_STATUS": "Secondary interrupt/status line"
      }
    },

    "adc_monitoring": {
      "ADC_MOD1": {
        "source": "module",
        "usage": ["VCC monitoring", "temperature", "PoE PD/PSE VOUT"]
      },
      "ADC_MOD2": {
        "source": "module",
        "usage": ["extra analog sensor", "PoE supply monitor"]
      }
    },

    "safety_rules": {
      "enable_logic": {
        "no_high_signals_before": [
          "module_identified_in_software",
          "module_power_good"
        ],
        "signals_protected": ["EN_RESET", "VCC_SWITCHED_3V3", "GPIO_GEN1", "GPIO_GEN2"]
      },
      "power_priority": {
        "order": ["VCC_MAIN", "VCC_PD", "VCC_BAT"],
        "description": "Clear priority to avoid reset flapping"
      },
      "module_power_policy": {
        "modules_may_generate_own_3v3": true,
        "must_be_controlled_by": ["VCC_SWITCHED_3V3", "EN_RESET"]
      }
    }
  }
}
